{
  "name": "netlify-extension-services-reader",
  "description": "Select and run one of the following Netlify read operations (read-only) get-extensions, get-full-extension-details",
  "inputSchema": {
    "type": "object",
    "properties": {
      "selectSchema": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "get-extensions"
              },
              "params": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              },
              "llmModelName": {
                "type": "string"
              },
              "aiAgentName": {
                "type": "string"
              }
            },
            "required": [
              "operation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "get-full-extension-details"
              },
              "params": {
                "type": "object",
                "properties": {
                  "extensionSlug": {
                    "type": "string"
                  },
                  "teamId": {
                    "type": "string",
                    "description": "Team id of the current project team. If unsure, ask what Netlify team"
                  }
                },
                "required": [
                  "extensionSlug",
                  "teamId"
                ],
                "additionalProperties": false
              },
              "llmModelName": {
                "type": "string"
              },
              "aiAgentName": {
                "type": "string"
              }
            },
            "required": [
              "operation"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "required": [
      "selectSchema"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}